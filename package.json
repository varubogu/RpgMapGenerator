{
	"name": "rpg-map-generator",
	"version": "0.1.0",
	"description": "RPGツクールMV/MZ向けのダンジョンマップをビルド時に自動生成するツール",
	"type": "module",
	"bin": {
		"rpgmapgen": "dist/presentation/cli.js"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsx src/presentation/cli.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p web",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "npm run typecheck && npm run lint && npm run test",
		"web:dev": "vite web",
		"web:build": "vite build web",
		"web:preview": "npm run web:build && wrangler dev",
		"deploy": "npm run web:build && wrangler deploy"
	},
	"dependencies": {
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/node": "^26.6.6",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"wrangler": "^4.160.1"
	},
	"license": "MIT"
}
